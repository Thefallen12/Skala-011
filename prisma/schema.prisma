generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Project lifecycle and planning.
enum ProjectStatus {
  PENDING_SETUP
  RUNNING
  PENDING
  ON_PROGRESS
  TERHAMBAT
  DONE
  // Retained for compatibility with existing project records.
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CalendarEventType {
  PROJECT
  MEETING
  DEADLINE
  DELIVERY
  OTHER
}

enum CalendarEventFormat {
  VIRTUAL
  HYBRID
  IN_PERSON
}

enum HabitFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum RequestStatus {
  PENDING_KOORDINATOR
  PENDING_KEUANGAN
  PENDING_LOGISTIK
  ON_DELIVERY
  COMPLETED
  REJECTED
}

// Inventory, procurement, payment, and delivery.
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum DirectStockPurchaseStatus {
  PENDING_RECEIPT
  RECEIVED
}

enum EquipmentStatus {
  READY
  IN_USE
  MAINTENANCE
  BROKEN
}

enum VehicleFuelSource {
  SPBU
  RETAIL
}

enum VehicleFuelRequestStatus {
  PENDING_FINANCE
  FUNDED
  REJECTED
  PROOF_SUBMITTED
  COMPLETED
}

enum TicketType {
  MATERIAL
  COST
  OPERATIONAL
}

enum TicketRequestCategory {
  OPS
  MATERIAL
  WAREHOUSE
  OFFICE
  FIELD
}

enum TicketFieldCategory {
  HAULING
  LABOR
  DIRECT_STORE
}

enum TicketStatus {
  DRAFT
  PENDING_DIRECTOR
  APPROVED_DIR
  PROCESSED_FINANCE
  PROCESSED_LOGISTIC
  ASSIGNED_TO_MOVER
  IN_TRANSIT
  WAITING_FINANCE_PAYMENT
  COMPLETED
  REJECTED
}

enum TicketCategoryHint {
  WAREHOUSE
  PURCHASE
}

enum FulfillmentStatus {
  PENDING
  PROCESSED_TO_DO
  PROCESSED_TO_PO
}

enum TicketFulfillmentStatus {
  PENDING
  PARTIALLY_FULFILLED
  COMPLETED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Documents, signatures, and subcontract approvals.
enum OperationalDocumentKind {
  PURCHASE_ORDER
  DELIVERY_ORDER
  CUSTOM
}

enum OperationalDocumentStatus {
  SIGNED
  ISSUED
}

enum DocType {
  INVOICE
  PURCHASE_ORDER
  DO
  SPK
  SURAT_JALAN
  BAST
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum PaymentType {
  DOWN_PAYMENT
  PROGRESS_PAYMENT
  FULL_PAYMENT
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
}

enum POPaymentMethod {
  CASH
  TRANSFER
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  APPROVAL
}

enum DOStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  RETURNED
}

enum DODeliveryMethod {
  INTERNAL_MOVER
  EXPEDITION
}

enum BlueprintCategory {
  SHOP_DRAWING
  AS_BUILT
  ARCHITECTURAL
  STRUCTURAL
  MEP
}

enum BlueprintStatus {
  DRAFT
  FOR_APPROVAL
  APPROVED_FOR_CONSTRUCTION
  REVISED
  REJECTED
}

enum SPKStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  TERMINATED
  REJECTED
}

enum SubkonTermynStatus {
  SUBMITTED
  FIELD_VERIFIED
  FINANCE_CHECKED
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
}

enum ProjectAddendumStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum BASTType {
  PHO
  FHO
}

enum UserRole {
  DIRECTOR        @map("DIRECTUR")
  DEPUTY_DIRECTOR @map("WAKIL_DIRECTUR")
  DRAFTER
  FINANCE         @map("KEUANGAN")
  LOGISTICS       @map("KOORDINATOR_LOGISTIK")
  KOORDINATOR     @map("KOORDINATOR_LAPANGAN")
  FIELD_TEAM      @map("TIM_LAPANGAN")
  MOVER
  ADMINISTRATIONS @map("ADMIN")

  @@map("Role")
}

// Identity, access, and user-owned records.
model User {
  id                                                String                        @id @default(cuid())
  name                                              String
  email                                             String                        @unique
  phone                                             String?
  profilePhotoUrl                                   String?
  bankName                                          String?
  bankAccountName                                   String?
  bankAccountNumber                                 String?
  passwordHash                                      String                        @map("password")
  role                                              UserRole                      @default(FIELD_TEAM)
  isActive                                          Boolean                       @default(true)
  lastLoginAt                                       DateTime?
  createdAt                                         DateTime                      @default(now())
  updatedAt                                         DateTime
  CalendarEvent                                     CalendarEvent[]
  notes                                             UserNote[]
  MaterialRequest_MaterialRequest_approverIdToUser  MaterialRequest[]             @relation("MaterialRequest_approverIdToUser")
  MaterialRequest_MaterialRequest_requesterIdToUser MaterialRequest[]             @relation("MaterialRequest_requesterIdToUser")
  Session                                           Session[]
  tickets                                           Ticket[]
  processedPaymentTransactions                      PaymentTransaction[]          @relation("PaymentTransactionProcessor")
  approvedDirectStockPurchases                      DirectStockPurchase[]         @relation("DirectStockPurchaseApprover")
  ticketAuditLogs                                   TicketAuditLog[]
  assignedProjects                                  Project[]                     @relation("ProjectFieldPic")
  fieldSurveys                                      FieldSurvey[]                 @relation("FieldSurveyor")
  proposedWorkPointWages                            ProjectWorkPoint[]            @relation("WorkPointWageProposer")
  approvedWorkPointWages                            ProjectWorkPoint[]            @relation("WorkPointWageApprover")
  draftedBlueprints                                 Blueprint[]                   @relation("BlueprintDrafter")
  reviewedBlueprints                                Blueprint[]                   @relation("BlueprintReviewer")
  createdSubkonContracts                            SubkonContract[]              @relation("SubkonContractCreator")
  approvedSubkonContracts                           SubkonContract[]              @relation("SubkonContractApprover")
  createdSubkonTermyns                              SubkonTermyn[]                @relation("SubkonTermynCreator")
  verifiedSubkonTermyns                             SubkonTermyn[]                @relation("SubkonTermynFieldVerifier")
  reviewedSubkonTermyns                             SubkonTermyn[]                @relation("SubkonTermynFinanceReviewer")
  approvedSubkonTermyns                             SubkonTermyn[]                @relation("SubkonTermynApprover")
  paidSubkonTermyns                                 SubkonTermyn[]                @relation("SubkonTermynPayer")
  createdProjectAddendums                           ProjectAddendum[]             @relation("ProjectAddendumCreator")
  approvedProjectAddendums                          ProjectAddendum[]             @relation("ProjectAddendumApprover")
  approvedBASTDocuments                             BASTDocument[]                @relation("BASTApprover")
  createdEquipmentLogs                              EquipmentLog[]                @relation("EquipmentLogCreator")
  createdVehicleTripLogs                            VehicleTripLog[]              @relation("VehicleTripLogCreator")
  vehicleFuelRequests                               VehicleFuelRequest[]          @relation("VehicleFuelRequester")
  reviewedVehicleFuelRequests                       VehicleFuelRequest[]          @relation("VehicleFuelReviewer")
  releasedSubkonRetentions                          SubkonContract[]              @relation("SubkonContractRetentionReleaser")
  habits                                            Habit[]
  createdWorkTasks                                  WorkTask[]                    @relation("WorkTaskCreator")
  assignedWorkTasks                                 WorkTask[]                    @relation("WorkTaskAssignee")
  workTaskMemberships                               WorkTaskMember[]
  timesheetEntries                                  TimesheetEntry[]
  calendarReminders                                 CalendarEventReminder[]
  calendarEventParticipants                         CalendarEventParticipant[]
  createdDocumentTemplates                          OperationalDocumentTemplate[] @relation("DocumentTemplateCreator")
  createdPurchaseOrders                             PurchaseOrder[]               @relation("PurchaseOrderCreator")
  reviewedPurchaseOrders                            PurchaseOrder[]               @relation("PurchaseOrderReviewer")
  approvedPurchaseOrders                            PurchaseOrder[]               @relation("PurchaseOrderApprover")
  createdDeliveryOrders                             DeliveryOrder[]               @relation("DeliveryOrderCreator")
  preparedOperationalDocuments                      OperationalDocument[]         @relation("OperationalDocumentPreparer")
  signedOperationalDocuments                        OperationalDocument[]         @relation("OperationalDocumentSigner")
  issuedOperationalDocuments                        OperationalDocument[]         @relation("OperationalDocumentIssuer")
  issuedDocuments                                   IssuedDocument[]              @relation("IssuedDocumentIssuer")
  assignedMoverTickets                              Ticket[]                      @relation("Ticket_moverAssigneeIdToUser")
  stockPurchases                                    StockPurchase[]               @relation("StockPurchaseCreator")
  createdDirectStockPurchases                       DirectStockPurchase[]         @relation("DirectStockPurchaseCreator")
  receivedDirectStockPurchases                      DirectStockPurchase[]         @relation("DirectStockPurchaseReceiver")
  createdStockMovements                             StockMovement[]               @relation("StockMovementCreator")
  receivedDeliveryOrders                            DeliveryOrder[]               @relation("DeliveryOrderReceiver")
  wageAuditLogs                                     WageAuditLog[]                @relation("WageAuditChanger")
  createdProjectWageDisbursements                   ProjectWageDisbursement[]     @relation("ProjectWageDisbursementCreator")
  notifications                                     Notification[]                @relation("UserNotifications")
}

model UserNote {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @db.Text
  color     String   @default("primary") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  actionUrl String?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt])
}

// Scheduling and collaboration.
model CalendarEvent {
  id              String                     @id
  title           String
  description     String?
  type            CalendarEventType          @default(PROJECT)
  startsAt        DateTime
  endsAt          DateTime?
  projectId       String?
  project         Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  meetingUrl      String?
  location        String?
  format          CalendarEventFormat        @default(HYBRID)
  allDay          Boolean                    @default(false)
  reminderMinutes Int?
  createdById     String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime
  User            User                       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  reminders       CalendarEventReminder[]
  participants    CalendarEventParticipant[]

  @@index([projectId, startsAt])
  @@index([createdById, startsAt])
  @@index([startsAt])
}

model CalendarEventReminder {
  id        String        @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime      @default(now())
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, createdAt])
}

model CalendarEventParticipant {
  id        String        @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime      @default(now())
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, eventId])
}

model MaterialRequest {
  id                                     String        @id
  title                                  String
  description                            String?
  estimatedCost                          Decimal?      @db.Decimal(14, 2)
  status                                 RequestStatus @default(PENDING_KOORDINATOR)
  requesterId                            String
  approverId                             String?
  fundsApprovedAt                        DateTime?
  fundsDisbursedAt                       DateTime?
  purchasedAt                            DateTime?
  deliveredAt                            DateTime?
  createdAt                              DateTime      @default(now())
  updatedAt                              DateTime
  User_MaterialRequest_approverIdToUser  User?         @relation("MaterialRequest_approverIdToUser", fields: [approverId], references: [id])
  User_MaterialRequest_requesterIdToUser User          @relation("MaterialRequest_requesterIdToUser", fields: [requesterId], references: [id])
  RequestItem                            RequestItem[]

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}

model RequestItem {
  id              String          @id
  materialName    String
  quantity        Int
  unit            String
  requestId       String
  MaterialRequest MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model Session {
  id        String   @id
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, expiresAt])
}

model VerificationToken {
  identifier String   @id
  token      String   @unique
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([expires])
}

// Personal productivity and time tracking.
model Habit {
  id          String            @id @default(cuid())
  userId      String
  title       String
  description String?
  frequency   HabitFrequency    @default(DAILY)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  User        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId, createdAt])
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  date        DateTime @db.Date
  completedAt DateTime @default(now())
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

model WorkTask {
  id          String           @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  status      WorkTaskStatus   @default(TODO)
  color       String           @default("blue") @db.VarChar(20)
  projectId   String
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User             @relation("WorkTaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?            @relation("WorkTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  members     WorkTaskMember[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([projectId, startsAt, endsAt])
  @@index([assigneeId, startsAt])
}

model WorkTaskMember {
  id         String   @id @default(cuid())
  workTaskId String
  userId     String
  createdAt  DateTime @default(now())
  workTask   WorkTask @relation(fields: [workTaskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workTaskId, userId])
  @@index([userId, workTaskId])
}

model TimesheetEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workDate        DateTime @db.Date
  durationMinutes Int
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, workDate])
  @@index([projectId, workDate])
}

// Projects, field operations, and progress evidence.
model Project {
  id                  String                    @id @default(cuid())
  code                String                    @unique
  name                String
  title               String
  isDeleted           Boolean                   @default(false)
  kelompokTani        String
  address             String
  jenisPekerjaan      String?
  pagu                Decimal                   @db.Decimal(18, 2)
  landArea            Decimal?                  @db.Decimal(12, 2)
  progress            Float                     @default(0)
  priority            ProjectPriority           @default(MEDIUM)
  vendor              String?
  clientName          String?
  location            String?
  status              ProjectStatus             @default(PENDING_SETUP)
  startDate           DateTime?
  endDate             DateTime?
  budget              Decimal?                  @db.Decimal(18, 2)
  fieldPicId          String?
  fieldPic            User?                     @relation("ProjectFieldPic", fields: [fieldPicId], references: [id], onDelete: SetNull)
  fieldSurveys        FieldSurvey[]
  dailyReports        DailyReport[]
  workPoints          ProjectWorkPoint[]
  wageDisbursements   ProjectWageDisbursement[]
  stockMovements      StockMovement[]
  tickets             Ticket[]
  calendarEvents      CalendarEvent[]
  workTasks           WorkTask[]
  timesheetEntries    TimesheetEntry[]
  blueprints          Blueprint[]
  subkonContracts     SubkonContract[]
  equipmentLogs       EquipmentLog[]
  vehicleTripLogs     VehicleTripLog[]
  vehicleFuelRequests VehicleFuelRequest[]
  addendums           ProjectAddendum[]
  bastDocuments       BASTDocument[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([fieldPicId])
}

model FieldSurvey {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName     String
  locationName    String
  responsibleName String
  surveyorId      String
  surveyor        User     @relation("FieldSurveyor", fields: [surveyorId], references: [id], onDelete: Restrict)
  geoJsonData     Json
  areaSqm         Float?
  lengthM         Float?
  perimeterM      Float?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([surveyorId, createdAt])
}

model DailyReport {
  id             String                 @id @default(cuid())
  projectId      String
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportDate     DateTime               @db.Date
  weather        String?
  workersCount   Int                    @default(0)
  progress       Float?
  equipment      Json?
  workSummary    String?
  notes          String?
  k3SafetyLog    String?                @db.Text
  progressPhotos ProjectProgressPhoto[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([projectId, reportDate])
  @@index([reportDate])
}

model ProjectProgressPhoto {
  id            String      @id @default(cuid())
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  url           String      @unique
  fileUrl       String?
  publicId      String?
  createdAt     DateTime    @default(now())

  @@index([dailyReportId, createdAt])
}

model ProjectWorkPoint {
  id                String                     @id @default(cuid())
  projectId         String
  project           Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String
  location          String?
  plannedStartDate  DateTime?                  @db.Date
  targetDate        DateTime?                  @db.Date
  proposedVolume    Decimal?                   @db.Decimal(14, 3)
  proposedUnit      String?
  proposedUnitPrice Decimal?                   @db.Decimal(18, 2)
  proposedTotalWage Decimal                    @db.Decimal(18, 2)
  approvedTotalWage Decimal?                   @db.Decimal(18, 2)
  wageApprovedAt    DateTime?
  proposedById      String
  proposedBy        User                       @relation("WorkPointWageProposer", fields: [proposedById], references: [id], onDelete: Restrict)
  wageApprovedById  String?
  wageApprovedBy    User?                      @relation("WorkPointWageApprover", fields: [wageApprovedById], references: [id], onDelete: SetNull)
  progress          Float                      @default(0)
  progressReports   ProjectWorkPointProgress[]
  wageAuditLogs     WageAuditLog[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([projectId, createdAt])
  @@index([proposedById])
}

model Blueprint {
  id            String            @id @default(cuid())
  publicCode    String            @unique
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  drawingNumber String
  title         String
  category      BlueprintCategory @default(SHOP_DRAWING)
  revision      String            @default("REV-00")
  fileUrl       String
  status        BlueprintStatus   @default(DRAFT)
  drafterId     String
  drafter       User              @relation("BlueprintDrafter", fields: [drafterId], references: [id], onDelete: Restrict)
  reviewerId    String?
  reviewer      User?             @relation("BlueprintReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId, drawingNumber])
  @@index([status, updatedAt])
}

model ProjectWorkPointProgress {
  id          String                          @id @default(cuid())
  workPointId String
  workPoint   ProjectWorkPoint                @relation(fields: [workPointId], references: [id], onDelete: Cascade)
  reportDate  DateTime                        @db.Date
  progress    Float
  workSummary String?
  photos      ProjectWorkPointProgressPhoto[]
  createdAt   DateTime                        @default(now())

  @@index([workPointId, reportDate])
}

model ProjectWorkPointProgressPhoto {
  id               String                   @id @default(cuid())
  progressReportId String
  progressReport   ProjectWorkPointProgress @relation(fields: [progressReportId], references: [id], onDelete: Cascade)
  url              String                   @unique
  fileUrl          String?
  publicId         String?
  createdAt        DateTime                 @default(now())

  @@index([progressReportId, createdAt])
}

// Inventory and purchasing.
model StockMovement {
  id           String            @id @default(cuid())
  projectId    String?
  project      Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  stockItemId  String?
  stockItem    StockItem?        @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  type         StockMovementType
  materialName String
  quantity     Decimal           @db.Decimal(14, 3)
  totalCost    Decimal?          @db.Decimal(18, 2)
  unit         String
  occurredAt   DateTime          @default(now())
  reference    String?
  notes        String?
  createdById  String?
  createdBy    User?             @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime          @default(now())

  @@index([projectId, occurredAt])
  @@index([stockItemId, occurredAt])
  @@index([materialName])
}

model StockItem {
  id                  String                    @id @default(cuid())
  sku                 String                    @unique
  name                String
  category            String                    @default("MATERIAL")
  unit                String
  stockQuantity       Decimal                   @default(0) @db.Decimal(14, 3)
  minimumStock        Decimal                   @default(0) @db.Decimal(14, 3)
  unitPrice           Decimal                   @default(0) @db.Decimal(18, 2)
  purchases           StockPurchase[]
  directPurchaseItems DirectStockPurchaseItem[]
  movements           StockMovement[]
  purchaseOrderItems  POItem[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([name])
  @@map("LogisticsStockItem")
}

model StockPurchase {
  id              String         @id @default(cuid())
  purchaseNumber  String         @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  stockItemId     String
  stockItem       StockItem      @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity        Decimal        @db.Decimal(14, 3)
  unitPrice       Decimal        @db.Decimal(18, 2)
  supplierName    String?
  reference       String?
  notes           String?        @db.Text
  createdById     String
  createdBy       User           @relation("StockPurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now())

  @@index([stockItemId, createdAt])
  @@index([createdById, createdAt])
  @@index([purchaseOrderId])
}

model DirectStockPurchase {
  id                   String                    @id @default(cuid())
  purchaseNumber       String                    @unique
  vendorId             String?
  vendor               Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  ticketId             String?
  ticket               Ticket?                   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  vendorName           String
  paymentMethod        POPaymentMethod           @default(CASH)
  paymentBankName      String?
  paymentAccountNumber String?
  paymentAccountName   String?
  paymentTerms         String?
  includeTax           Boolean                   @default(false)
  totalAmount          Decimal                   @db.Decimal(18, 2)
  paidAt               DateTime?
  reference            String?
  notes                String?                   @db.Text
  status               DirectStockPurchaseStatus @default(PENDING_RECEIPT)
  isApprovedByDirector Boolean                   @default(false)
  approvedById         String?
  approvedBy           User?                     @relation("DirectStockPurchaseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  receivedAt           DateTime?
  receivedById         String?
  receivedBy           User?                     @relation("DirectStockPurchaseReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  arrivalPhotoUrl      String?
  receivedPhotos       String[]                  @default([])
  createdById          String
  createdBy            User                      @relation("DirectStockPurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items                DirectStockPurchaseItem[]
  paymentTransactions  PaymentTransaction[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([vendorId, createdAt])
  @@index([ticketId, createdAt])
  @@index([createdById, createdAt])
  @@index([receivedById, receivedAt])
  @@index([isApprovedByDirector, createdAt])
}

model DirectStockPurchaseItem {
  id          String              @id @default(cuid())
  purchaseId  String
  purchase    DirectStockPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem           @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  itemName    String
  unit        String
  quantity    Decimal             @db.Decimal(14, 3)
  unitPrice   Decimal             @db.Decimal(18, 2)
  totalPrice  Decimal             @db.Decimal(18, 2)

  @@index([purchaseId])
  @@index([stockItemId])
}

model Vendor {
  id                   String                @id @default(cuid())
  code                 String                @unique
  name                 String
  category             String
  address              String?
  phone                String?
  email                String?
  bankName             String?
  bankAccount          String?
  bankHolder           String?
  rating               Float                 @default(5)
  isApproved           Boolean               @default(true)
  purchaseOrders       PurchaseOrder[]
  directStockPurchases DirectStockPurchase[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([name])
  @@index([category, isApproved])
}

// Labor, equipment, and subcontract lifecycle.
model WageAuditLog {
  id          String           @id @default(cuid())
  workPointId String
  workPoint   ProjectWorkPoint @relation(fields: [workPointId], references: [id], onDelete: Cascade)
  oldWage     Decimal          @db.Decimal(18, 2)
  newWage     Decimal          @db.Decimal(18, 2)
  changedById String
  changedBy   User             @relation("WageAuditChanger", fields: [changedById], references: [id], onDelete: Restrict)
  reason      String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([workPointId, createdAt])
  @@index([changedById, createdAt])
}

model ProjectWageDisbursement {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(18, 2)
  receiptNumber String
  paidAt        DateTime @db.Date
  notes         String?  @db.Text
  paidById      String
  paidBy        User     @relation("ProjectWageDisbursementCreator", fields: [paidById], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([projectId, paidAt])
  @@index([paidById, paidAt])
}

model EquipmentMaster {
  id           String          @id @default(cuid())
  code         String          @unique
  name         String
  brand        String?
  licensePlate String?
  hourlyRate   Decimal         @default(0) @db.Decimal(18, 2)
  status       EquipmentStatus @default(READY)
  currentHM    Decimal         @default(0) @db.Decimal(12, 2)
  logs         EquipmentLog[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([name])
  @@index([status])
}

model SubkonContract {
  id                       String         @id @default(cuid())
  publicCode               String         @unique
  contractNumber           String         @unique
  projectId                String
  project                  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subkonName               String
  workScope                String         @db.Text
  contractValue            Decimal        @db.Decimal(18, 2)
  retentionPct             Decimal        @default(5) @db.Decimal(5, 2)
  status                   SPKStatus      @default(DRAFT)
  createdById              String
  createdBy                User           @relation("SubkonContractCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById             String?
  approvedBy               User?          @relation("SubkonContractApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt               DateTime?
  retentionReleasedAt      DateTime?
  retentionReleaseProofUrl String?
  retentionReleasedById    String?
  retentionReleasedBy      User?          @relation("SubkonContractRetentionReleaser", fields: [retentionReleasedById], references: [id], onDelete: SetNull)
  termyns                  SubkonTermyn[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([projectId, status])
  @@index([status, createdAt])
}

model SubkonTermyn {
  id                  String             @id @default(cuid())
  subkonContractId    String
  subkonContract      SubkonContract     @relation(fields: [subkonContractId], references: [id], onDelete: Cascade)
  termynNumber        Int
  claimedPercent      Decimal            @db.Decimal(5, 2)
  grossAmount         Decimal            @db.Decimal(18, 2)
  retentionAmount     Decimal            @db.Decimal(18, 2)
  netAmount           Decimal            @db.Decimal(18, 2)
  status              SubkonTermynStatus @default(SUBMITTED)
  paymentProofUrl     String?
  createdById         String
  createdBy           User               @relation("SubkonTermynCreator", fields: [createdById], references: [id], onDelete: Restrict)
  fieldVerifiedById   String?
  fieldVerifiedBy     User?              @relation("SubkonTermynFieldVerifier", fields: [fieldVerifiedById], references: [id], onDelete: SetNull)
  fieldVerifiedAt     DateTime?
  financeReviewedById String?
  financeReviewedBy   User?              @relation("SubkonTermynFinanceReviewer", fields: [financeReviewedById], references: [id], onDelete: SetNull)
  financeReviewedAt   DateTime?
  approvedById        String?
  approvedBy          User?              @relation("SubkonTermynApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt          DateTime?
  paidById            String?
  paidBy              User?              @relation("SubkonTermynPayer", fields: [paidById], references: [id], onDelete: SetNull)
  paidAt              DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([subkonContractId, termynNumber])
  @@index([status, createdAt])
}

model EquipmentLog {
  id                String           @id @default(cuid())
  equipmentMasterId String?
  equipmentMaster   EquipmentMaster? @relation(fields: [equipmentMasterId], references: [id], onDelete: SetNull)
  projectId         String
  project           Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipmentName     String
  operatorName      String?
  date              DateTime         @db.Date
  hmStart           Decimal          @db.Decimal(12, 2)
  hmEnd             Decimal          @db.Decimal(12, 2)
  effectiveHours    Decimal          @db.Decimal(8, 2)
  fuelLiter         Decimal          @db.Decimal(10, 2)
  notes             String?          @db.Text
  createdById       String
  createdBy         User             @relation("EquipmentLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime         @default(now())

  @@index([projectId, date])
}

// Project approvals, handover, and document numbering.
model ProjectAddendum {
  id             String                @id @default(cuid())
  projectId      String
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addendumNumber String                @unique
  budgetChange   Decimal               @db.Decimal(18, 2)
  timeExtension  Int
  reason         String                @db.Text
  status         ProjectAddendumStatus @default(DRAFT)
  createdById    String
  createdBy      User                  @relation("ProjectAddendumCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById   String?
  approvedBy     User?                 @relation("ProjectAddendumApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([projectId, status])
}

model BASTDocument {
  id                String    @id @default(cuid())
  publicCode        String    @unique
  bastNumber        String    @unique
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type              BASTType  @default(PHO)
  date              DateTime  @db.Date
  maintenanceEndsAt DateTime? @db.Date
  notes             String?   @db.Text
  isApproved        Boolean   @default(false)
  approvedById      String?
  approvedBy        User?     @relation("BASTApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([projectId, type, isApproved])
}

model DocumentNumberSequence {
  kind  String
  year  Int
  value Int    @default(0)

  @@id([kind, year])
}

// Ticket intake and fulfillment.
model Ticket {
  id                      String                  @id @default(cuid())
  ticketNumber            String                  @unique
  title                   String
  description             String?                 @db.Text
  type                    TicketType
  priority                TicketPriority          @default(MEDIUM)
  status                  TicketStatus            @default(DRAFT)
  fulfillmentStatus       TicketFulfillmentStatus @default(PENDING)
  totalAmount             Decimal?                @db.Decimal(18, 2)
  requestedAmount         Float?
  isApprovedByDirector    Boolean                 @default(false)
  attachmentUrl           String?
  requestCategory         TicketRequestCategory?
  fieldCategory           TicketFieldCategory?
  recipientName           String?
  bankName                String?
  accountNumber           String?
  purchaseReceiptUrl      String?
  transferReceiptUrl      String?
  transferDestination     String?
  deliveryReceiptUrl      String?
  deliveryOrderReceiptUrl String?
  moverAssigneeId         String?
  requesterId             String
  requester               User                    @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  moverAssignee           User?                   @relation("Ticket_moverAssigneeIdToUser", fields: [moverAssigneeId], references: [id])
  projectId               String?
  project                 Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items                   TicketItem[]
  purchaseOrders          PurchaseOrder[]
  directStockPurchases    DirectStockPurchase[]
  paymentTransactions     PaymentTransaction[]
  auditLogs               TicketAuditLog[]
  operationalDocuments    OperationalDocument[]
  deliveryOrders          DeliveryOrder[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([status, type])
  @@index([status, priority])
  @@index([requesterId])
  @@index([projectId])
  @@index([moverAssigneeId, status])
}

// Purchase orders, delivery orders, and digital documents.
model OperationalDocumentTemplate {
  id          String                  @id @default(cuid())
  name        String
  kind        OperationalDocumentKind
  title       String
  content     String                  @db.Text
  isActive    Boolean                 @default(true)
  createdById String
  createdBy   User                    @relation("DocumentTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents   OperationalDocument[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([kind, isActive])
  @@index([createdById])
}

model DocumentTemplate {
  id              String           @id @default(cuid())
  name            String
  type            DocType
  contentHtml     String           @db.Text
  contentJson     Json?
  variables       String
  issuedDocuments IssuedDocument[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model PurchaseOrder {
  id                   String               @id @default(cuid())
  publicCode           String               @unique
  poNumber             String               @unique
  vendorName           String
  paymentMethod        POPaymentMethod      @default(CASH)
  paymentBankName      String?
  paymentAccountNumber String?
  paymentAccountName   String?
  paymentTerms         String?
  includeTax           Boolean              @default(false)
  transferDestination  String?
  paymentReceiptUrl    String?
  paidAt               DateTime?
  status               POStatus             @default(DRAFT)
  createdById          String?
  createdBy            User?                @relation("PurchaseOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  vendorId             String?
  vendor               Vendor?              @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  reviewedById         String?
  reviewedBy           User?                @relation("PurchaseOrderReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt           DateTime?
  approvedById         String?
  approvedBy           User?                @relation("PurchaseOrderApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt           DateTime?
  ticketId             String?
  ticket               Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  items                POItem[]
  deliveryOrders       DeliveryOrder[]
  stockPurchases       StockPurchase[]
  paymentTransactions  PaymentTransaction[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, updatedAt])
  @@index([ticketId])
  @@index([createdById])
  @@index([reviewedById])
  @@index([approvedById])
  @@index([vendorId])
}

model PaymentTransaction {
  id                    String               @id @default(cuid())
  poId                  String?
  po                    PurchaseOrder?       @relation(fields: [poId], references: [id], onDelete: SetNull)
  ticketId              String?
  ticket                Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  directStockPurchaseId String?
  directStockPurchase   DirectStockPurchase? @relation(fields: [directStockPurchaseId], references: [id], onDelete: SetNull)
  paymentType           PaymentType
  amount                Float
  transferDestination   String
  status                PaymentStatus        @default(PENDING)
  processedById         String?
  processedBy           User?                @relation("PaymentTransactionProcessor", fields: [processedById], references: [id], onDelete: SetNull)
  proofOfTransferUrl    String?
  paidAt                DateTime?
  createdAt             DateTime             @default(now())

  @@index([poId, status, createdAt])
  @@index([ticketId, status, createdAt])
  @@index([directStockPurchaseId, status, createdAt])
  @@index([processedById])
}

model DeliveryOrder {
  id                    String               @id @default(cuid())
  publicCode            String               @unique
  doNumber              String               @unique
  ticketId              String?
  ticket                Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  poId                  String?
  po                    PurchaseOrder?       @relation(fields: [poId], references: [id], onDelete: SetNull)
  createdById           String?
  createdBy             User?                @relation("DeliveryOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  receivedById          String?
  receivedBy            User?                @relation("DeliveryOrderReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  deliveryMethod        DODeliveryMethod     @default(INTERNAL_MOVER)
  vehicleId             String?
  vehicle               Vehicle?             @relation("DeliveryOrderVehicle", fields: [vehicleId], references: [id], onDelete: SetNull)
  vehiclePlateNumber    String?
  departureKilometer    Decimal?             @db.Decimal(12, 2)
  vehicleDocumentNumber String?
  vehiclePlate          String?
  driverName            String?
  driverIdentityNumber  String?
  driverPhone           String?
  receiverName          String?
  receivedAt            DateTime?
  arrivalPhotoUrl       String?
  deliveryReceiptUrl    String?
  receiptPhotos         DeliveryOrderProof[]
  status                DOStatus             @default(PENDING)
  items                 DOItem[]
  vehicleTripLog        VehicleTripLog?
  fuelRequests          VehicleFuelRequest[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status, updatedAt])
  @@index([poId])
  @@index([ticketId])
  @@index([createdById])
  @@index([receivedById])
  @@index([vehicleId, status])
}

model DeliveryOrderProof {
  id              String        @id @default(cuid())
  deliveryOrderId String
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  url             String        @unique
  createdAt       DateTime      @default(now())

  @@index([deliveryOrderId, createdAt])
}

model Vehicle {
  id                  String               @id @default(cuid())
  plateNumber         String               @unique
  vehicleType         String
  brand               String?
  modelName           String?
  currentKilometer    Decimal              @default(0) @db.Decimal(12, 2)
  odometerInitialized Boolean              @default(false)
  status              String               @default("AVAILABLE")
  deliveryOrders      DeliveryOrder[]      @relation("DeliveryOrderVehicle")
  tripLogs            VehicleTripLog[]
  fuelRequests        VehicleFuelRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, plateNumber])
}

model VehicleTripLog {
  id                   String         @id @default(cuid())
  vehicleId            String
  vehicle              Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  deliveryOrderId      String?        @unique
  deliveryOrder        DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  projectId            String?
  project              Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kilometerStart       Decimal        @db.Decimal(12, 2)
  kilometerEnd         Decimal        @db.Decimal(12, 2)
  distanceKm           Decimal        @db.Decimal(12, 2)
  fuelLiter            Decimal        @db.Decimal(10, 2)
  fuelEfficiencyKmPerL Decimal        @default(12) @db.Decimal(5, 2)
  createdById          String
  createdBy            User           @relation("VehicleTripLogCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime       @default(now())

  @@index([vehicleId, createdAt])
  @@index([projectId, createdAt])
  @@index([createdById, createdAt])
}

model VehicleFuelRequest {
  id                    String                   @id @default(cuid())
  vehicleId             String
  vehicle               Vehicle                  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  deliveryOrderId       String
  deliveryOrder         DeliveryOrder            @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedById         String
  requestedBy           User                     @relation("VehicleFuelRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedById          String?
  reviewedBy            User?                    @relation("VehicleFuelReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  source                VehicleFuelSource
  estimatedDistanceKm   Decimal                  @db.Decimal(12, 2)
  exceptionDistanceKm   Decimal                  @default(0) @db.Decimal(12, 2)
  exceptionReason       String?                  @db.VarChar(300)
  estimatedFuelLiter    Decimal                  @db.Decimal(10, 2)
  unitPrice             Decimal                  @db.Decimal(12, 2)
  requestedAmount       Decimal                  @db.Decimal(18, 2)
  fuelEfficiencyKmPerL  Decimal                  @default(12) @db.Decimal(5, 2)
  disbursementMethod    POPaymentMethod?
  transferDestination   String?                  @db.VarChar(300)
  transferProofUrl      String?
  beforeFillingPhotoUrl String
  afterFillingPhotoUrl  String?
  receiptPhotoUrl       String?
  status                VehicleFuelRequestStatus @default(PENDING_FINANCE)
  financeNote           String?                  @db.Text
  reviewedAt            DateTime?
  disbursedAt           DateTime?
  proofSubmittedAt      DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([vehicleId, createdAt])
  @@index([deliveryOrderId, status])
  @@index([requestedById, createdAt])
}

model POItem {
  id          String        @id @default(cuid())
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem?    @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  itemName    String
  quantity    Float
  unit        String
  unitPrice   Float
  totalPrice  Float
  ticketItems TicketItem[]

  @@index([poId])
  @@index([stockItemId])
}

model DOItem {
  id           String        @id @default(cuid())
  doId         String
  do           DeliveryOrder @relation(fields: [doId], references: [id], onDelete: Cascade)
  itemName     String
  qtyOrdered   Float
  qtyDelivered Float
  unit         String        @default("pcs")
  remarks      String?
  ticketItems  TicketItem[]

  @@index([doId])
}

model IssuedDocument {
  id              String           @id @default(cuid())
  documentNumber  String           @unique
  templateId      String
  template        DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  relatedRecordId String?
  issuedById      String
  issuer          User             @relation("IssuedDocumentIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  status          String           @default("VALID")
  createdAt       DateTime         @default(now())

  @@index([templateId, createdAt])
  @@index([issuedById, createdAt])
}

model OperationalDocument {
  id             String                       @id @default(cuid())
  documentNumber String                       @unique
  kind           OperationalDocumentKind
  status         OperationalDocumentStatus    @default(SIGNED)
  title          String
  content        String                       @db.Text
  signatureImage String                       @db.Text
  signerName     String
  signerRole     UserRole
  signedAt       DateTime                     @default(now())
  preparedById   String
  preparedBy     User                         @relation("OperationalDocumentPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  signedById     String
  signedBy       User                         @relation("OperationalDocumentSigner", fields: [signedById], references: [id], onDelete: Restrict)
  issuedById     String?
  issuedBy       User?                        @relation("OperationalDocumentIssuer", fields: [issuedById], references: [id], onDelete: Restrict)
  issuedAt       DateTime?
  ticketId       String
  ticket         Ticket                       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  templateId     String?
  template       OperationalDocumentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt      DateTime                     @default(now())

  @@index([ticketId, status])
  @@index([kind, status])
  @@index([preparedById, createdAt])
  @@index([issuedById, issuedAt])
}

model TicketItem {
  id                   String             @id @default(cuid())
  ticketId             String
  ticket               Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  itemName             String
  quantity             Float
  unit                 String
  estimatedCost        Decimal?           @db.Decimal(18, 2)
  categoryHint         TicketCategoryHint @default(WAREHOUSE)
  expectedDeliveryDate DateTime?          @db.Date
  status               FulfillmentStatus  @default(PENDING)
  poItemId             String?
  poItem               POItem?            @relation(fields: [poItemId], references: [id], onDelete: SetNull)
  doItemId             String?
  doItem               DOItem?            @relation(fields: [doItemId], references: [id], onDelete: SetNull)

  @@index([ticketId, status])
  @@index([poItemId])
  @@index([doItemId])
}

model TicketAuditLog {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  action    String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([userId])
}
